PROJECT_NAME           = "alloy_ecs"
OUTPUT_DIRECTORY       = "@ALLOY_DOCS_OUTPUT@"
INPUT                  = "@ALLOY_DOCS_ROOT@/include" "@ALLOY_DOCS_ROOT@/src"
USE_MDFILE_AS_MAINPAGE =
EXAMPLE_PATH           = "@ALLOY_DOCS_ROOT@/examples"
RECURSIVE              = YES
FILE_PATTERNS          = *.hpp *.h *.cpp
STRIP_FROM_PATH        = "@ALLOY_DOCS_ROOT@"
EXTRACT_ALL            = NO
GENERATE_HTML          = YES
HTML_OUTPUT            = html
GENERATE_LATEX         = NO
GENERATE_TREEVIEW      = YES
DISABLE_INDEX          = NO
FULL_SIDEBAR           = NO
HTML_COLORSTYLE        = LIGHT
HTML_EXTRA_STYLESHEET  = "@ALLOY_DOCS_THEME@/doxygen-awesome.css"
HTML_COPY_CLIPBOARD    = NO
QUIET                  = YES
WARN_IF_UNDOCUMENTED   = YES
HAVE_DOT               = NO
